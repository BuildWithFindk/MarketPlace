      "isDeleted": false,
      "boundElements": null,
      "updated": 1787112433300,
      "link": null,
      "locked": false,
      "text": "AWS even provides a Distributed Load Testing solution designed to generate large numbers of virtual users across test runners. AWS describes it as capable of simulating hundreds to millions of concurrent users.\n\nAnd the AWS testing terminology is exactly what you're learning: concurrency, ramp-up, hold time, requests/sec, latency, errors, etc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS even provides a Distributed Load Testing solution designed to generate large numbers of virtual users across test runners. AWS describes it as capable of simulating hundreds to millions of concurrent users.\n\nAnd the AWS testing terminology is exactly what you're learning: concurrency, ramp-up, hold time, requests/sec, latency, errors, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    }
