    {
      "id": "3OcY38TeUG6GsWvSagbB-",
      "type": "text",
      "x": 84.70558624525779,
      "y": 516.5217539810516,
      "width": 822.8359375,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 1320707183,
      "version": 285,
      "versionNonce": 1325745825,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787112399335,
      "link": null,
      "locked": false,
      "text": "Your MacBook is doing both jobs:\n\nRunning the marketplace.\nGenerating the traffic.\n\nSo if you increase the load enough, you might eventually overload the load generator itself, rather than your Laravel application.\n\nThat's why larger-scale tests commonly use separate machines.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Your MacBook is doing both jobs:\n\nRunning the marketplace.\nGenerating the traffic.\n\nSo if you increase the load enough, you might eventually overload the load generator itself, rather than your Laravel application.\n\nThat's why larger-scale tests commonly use separate machines.",
      "autoResize": true,
      "lineHeight": 1.25
    },
